R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Optional: override the source endpoint (e.g. for local testing against MinIO
# instead of real Cloudflare R2). Leave empty to use
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ENDPOINT=

# RustFS, MinIO, or another S3-compatible API URL. Replace before running.
S3_ENDPOINT=s3-end-point-api-url
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
